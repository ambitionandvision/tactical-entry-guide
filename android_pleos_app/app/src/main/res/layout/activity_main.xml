<?xml version="1.0" encoding="utf-8"?>
<!-- portrait (1창, 2분할 시 약 840×1210dp). Phase 1 은 3D 없이 요약 카드가 가운데, Phase 2 는 3D + 하단 HUD. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_window">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Phase 1 에서는 INVISIBLE (MainActivity 가 제어). 시작 직후부터 숨김. -->
            <FrameLayout
                android:id="@+id/tacticalSurfaceContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="invisible" />

            <ScrollView
                android:id="@+id/summaryScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <io.github.ambitionandvision.tactical.ui.SummaryCardView
                        android:id="@+id/summaryCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_margin="@dimen/summary_card_margin" />
                </FrameLayout>
            </ScrollView>

            <io.github.ambitionandvision.tactical.ui.TacticalHudView
                android:id="@+id/tacticalHud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_margin="@dimen/panel_margin"
                android:visibility="gone" />
        </FrameLayout>

        <io.github.ambitionandvision.tactical.ui.DemoControlBarView
            android:id="@+id/demoControlBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <io.github.ambitionandvision.tactical.ui.ArrivedOverlayView
        android:id="@+id/arrivedOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
