*.iml

# 대용량 영상 (필요 시 외부 링크 사용)
docs/demo/*.mp4
docs/demo/*.mov
*.mkv

# APK 는 제출 규격 파일만 추적
apk/*
!apk/README.md
!apk/*_TacticalEntryGuide_release.apk

# 시뮬레이션 GPX 백업 (extract 로 재생성 가능)
gis_data/backup_simulated/

# 인수인계 묶음과 SHP 원본은 저장소에 넣지 않는다
handoff/
source_shp/

# 실주행 원본 로그 (출발지 포함). 저장소에는 import_real_gpx.py 로 잘라낸 구간만 넣는다
/*.gpx

# 파이썬 캐시 (로컬 경로가 들어간다)
__pycache__/
*.pyc

# 참고용 화면 이미지 (제3자 화면)
/*.jpeg
/*.jpg
/*.png
